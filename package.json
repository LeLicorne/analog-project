{
  "name": "analog-project",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "ng": "ng",
    "dev": "vite",
    "start": "bun run dev",
    "build": "vite build",
    "watch": "vite build --watch",
    "test": "vitest run",
    "preview": "node dist/analog/server/index.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "prepare": "simple-git-hooks"
  },
  "private": true,
  "dependencies": {
    "@analogjs/content": "^2.9.1",
    "@analogjs/router": "^2.9.1",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@tailwindcss/vite": "^4.1.4",
    "firebase": "^13.1.0",
    "front-matter": "^4.0.2",
    "marked": "^15.0.7",
    "marked-gfm-heading-id": "^4.1.1",
    "marked-highlight": "^2.2.1",
    "marked-mangle": "^1.1.10",
    "marked-shiki": "^1.1.0",
    "postcss": "^8.5.3",
    "rxjs": "~7.8.0",
    "shiki": "^1.6.1",
    "tailwindcss": "^4.1.4",
    "tslib": "^2.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@analogjs/platform": "^2.9.1",
    "@analogjs/vite-plugin-angular": "^2.9.1",
    "@analogjs/vitest-angular": "^2.9.1",
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "jsdom": "^22.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.0.0",
    "vite-tsconfig-paths": "^4.2.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "vite": "$vite",
    "vitest": "$vitest"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged && bun run typecheck"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
