{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "startServerCommand": "NODE_ENV=production SITE_URL=http://localhost:4173 PORT=4173 node dist/analog/server/index.mjs",
      "startServerReadyPattern": "Listening",
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/themes/histoire",
        "http://localhost:4173/quiz/histoire",
        "http://localhost:4173/a-propos"
      ],
      "settings": { "chromeFlags": "--no-sandbox --headless=new" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2800 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
