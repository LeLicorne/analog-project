# --- Déploiement (docker-compose, sur le VPS) ---
# Nom du projet Docker et domaine servi par Traefik (sans https://, sans www).
APP_NAME=quizz-du-jour
DOMAIN=quizz.example.com

# Config web Firebase (publique, mais à restreindre : domaines autorisés + App Check).
# Copier vers .env.local (ignoré par git) et renseigner les valeurs.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_USE_FIREBASE_EMULATORS=false

# Adresse publique du site (sans slash final) : canoniques, Open Graph, sitemap, robots.txt.
# À définir au build (VITE_SITE_URL) et à l'exécution du serveur (SITE_URL), avec la même valeur.
VITE_SITE_URL=http://localhost:4173
SITE_URL=http://localhost:4173
# Facultatif : affiché sur la page À propos pour signaler une erreur.
VITE_CONTACT_EMAIL=

# Clé publique Web Push (Console Firebase > Paramètres > Cloud Messaging > Certificats Web Push).
# Sans elle, le rappel quotidien est masqué.
VITE_FIREBASE_VAPID_KEY=

# Auteur du site (E-E-A-T) : affiché sur la page À propos et décrit en données structurées (Person, sameAs).
# Sans nom, rien n'est publié. Profils en https uniquement.
VITE_AUTHOR_NAME=
VITE_AUTHOR_GITHUB=
VITE_AUTHOR_LINKEDIN=
